PORT=3001
NODE_ENV=development

# Base de datos PostgreSQL: la MISMA que usa el bot de hdo-selling-module
# (base 'oasisbot', no una base nueva). Usar las mismas credenciales que
# figuran en hdo-selling-module/.env (POSTGRES_USERNAME/POSTGRES_PASSWORD/POSTGRES_HOST).
DATABASE_URL=postgres://postgres:password@localhost:5432/oasisbot

# Tango API Configuration
TANGO_API_BASE_URL=https://tiendas.axoft.com
TANGO_ACCESS_TOKEN=your_token_here
TANGO_PAGE_SIZE=5000

# Axoft "GetApiLiveQueryData" - usado para la vista de Deudas
AXOFT_API_BASE_URL=https://058430-001.connect.axoft.com/Api/GetApiLiveQueryData
AXOFT_API_KEY=your_api_authorization_key_here
AXOFT_COMPANY=136
AXOFT_PROCESS_CLIENTES=17961
AXOFT_PROCESS_DEUDAS=17952
